e.g. `K=4, v=1`: 2 image points, 8 preimages each — not 2 preimages each.
-/

/-- Decidable stand-in for `v2 n = j`, justified by `v2_eq_iff_mod`. -/
def v2EqDec (n j : ℕ) : Bool := n % 2 ^ (j + 1) == 2 ^ j

/-- Shell counts, computed via the decidable characterisation. -/
def shellCountsEval (k : ℕ) : List ℕ :=
  (List.range' 1 (k - 1)).map fun j =>
    ((List.range (2 ^ k)).filter (fun r => v2EqDec (3 * r + 1) j)).length

/-- CU (image size, fibre size at `m₀ = 1`) for each `v < K`. -/
def cuCountsEval (K : ℕ) : List (ℕ × ℕ × ℕ) :=
  (List.range K).map fun v =>
    let img := ((List.range (2 ^ K)).map (cuMap K v)).eraseDups
    let fib := ((List.range (2 ^ K)).filter (fun m => cuMap K v m == cuMap K v 1)).length
    (v, img.length, fib)

-- Calibration, k = 4 and k = 5 (expected [4,2,1] and [8,4,2,1]):
#eval shellCountsEval 4
#eval shellCountsEval 5
-- Defect count (expected 1 in both cases):
#eval ((List.range (2 ^ 4)).filter (fun r => (3 * r + 1) % 2 ^ 4 == 0)).length
#eval ((List.range (2 ^ 5)).filter (fun r => (3 * r + 1) % 2 ^ 5 == 0)).length
-- CU orientation, K = 4 and K = 5:
#eval cuCountsEval 4
#eval cuCountsEval 5

